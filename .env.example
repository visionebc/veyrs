# VEYRS — environment template. Never commit a real .env.
# Every setting is VEYRS_-prefixed; an unprefixed name is ignored.
# docs/SYSTEM_MANUAL.md §2 lists them all.
VEYRS_ENVIRONMENT=development
# >= 32 chars (shorter is refused at start; empty = a random key per process):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VEYRS_SECRET_KEY=
# Fernet key for credentials at rest:  python -m veyrs.cli keygen
VEYRS_ENCRYPTION_KEY=
# Only while rotating: earlier keys, decrypt-only (veyrs secrets rekey --apply, then remove)
VEYRS_ENCRYPTION_KEY_PREVIOUS=
VEYRS_DATABASE_URL=postgresql+psycopg://veyrs:change-me@127.0.0.1:5432/veyrs
VEYRS_REDIS_URL=redis://127.0.0.1:6379/0
VEYRS_PUBLIC_BASE_URL=https://veyrs.example.com
VEYRS_CORS_ORIGINS=https://veyrs.example.com
VEYRS_NVD_API_KEY=
VEYRS_EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
VEYRS_KEV_JSON_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
VEYRS_AI_ALLOW_EXTERNAL=false
# Stored third-party credentials: local (default) | mirror | vault.
# See docs/SYSTEM_MANUAL.md §2.2.1 for the VEYRS_VAULT_* settings.
VEYRS_SECRET_BACKEND=local
VEYRS_VAULT_ADDR=
VEYRS_VAULT_ROLE_ID=
VEYRS_VAULT_SECRET_ID_FILE=
