[Unit]
Description=VEYRS intelligence feed sync (NVD + EPSS + KEV + CWE)
Documentation=file:/opt/veyrs/scripts/sync-intel.sh
After=network-online.target veyrs-api.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/veyrs/scripts/sync-intel.sh
# NVD is rate-limited to 5 requests / 30 s without an API key, so a day with a
# large lastModified delta legitimately takes hours. A timeout here would kill
# a healthy run mid-corpus; the feed's own retry/backoff is the real guard.
TimeoutStartSec=infinity
User=root
# systemd defaults OOMPolicy to `stop`: when the kernel OOM-kills ANY process in
# this unit's cgroup, systemd SIGTERMs the rest of it. That is how an EPSS
# blow-up killed the wrapper shell mid-loop and `sync-kev` never ran for three
# nights (2026-08-14..16) -- a stale EPSS is a degraded signal, a stale KEV is a
# missed emergency, and the script's per-feed isolation was silently overridden.
OOMPolicy=continue
WorkingDirectory=/opt/veyrs/backend
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
