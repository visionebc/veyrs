# VEYRS container stack — environment template.
#
# Do NOT copy this by hand and fill in the blanks: run
#
#     docker/veyrs-docker.sh init
#
# which writes docker/.env with real random secrets, 0600. Every value below
# that says "generated" is a secret whose quality matters; a placeholder left
# in place is refused by compose at startup, not accepted quietly.
#
# This file is NOT /opt/veyrs/.env. That one belongs to a host install and
# points VEYRS_DATABASE_URL at a database on another machine; reusing it here
# would send the container stack at production. They are separate on purpose.

# ── Secrets ────────────────────────────────────────────────────────────────
# PostgreSQL superuser. Used by the cluster and by the `init` service (to read
# the RLS-forced `users` table). The api service never receives it.
POSTGRES_PASSWORD=

# The application's own database role. Deliberately NOT a superuser — a
# superuser bypasses row level security and VEYRS' tenant isolation with it.
VEYRS_DB_USER=veyrs
VEYRS_DB_PASSWORD=
VEYRS_DB_NAME=veyrs

# Session/JWT signing key. Empty means config.py mints a random one PER
# PROCESS: with 4 workers, tokens issued by one are rejected by the other
# three. At least 32 characters.
VEYRS_SECRET_KEY=

# Fernet key for credentials at rest (ITSM tokens, LDAP binds, scanner keys).
# Exactly a url-safe base64 encoding of 32 random bytes.
#
# ROTATING THIS MAKES EVERY STORED CREDENTIAL UNREADABLE. There is no recovery
# path: the ciphertext stays, the plaintext does not come back. Back it up with
# the database, not separately from it.
VEYRS_ENCRYPTION_KEY=

# ── First administrator ────────────────────────────────────────────────────
# Used ONCE, the first time the stack comes up. On later starts init.sh finds
# the account and leaves the password alone — changing the value here does NOT
# change the password (set VEYRS_FORCE_BOOTSTRAP=1 for that, on purpose).
VEYRS_ADMIN_ORG=veyrs
VEYRS_ADMIN_EMAIL=admin@veyrs.local
VEYRS_ADMIN_PASSWORD=
# Minimum length is 12 (config.py password_min_length); bootstrap exits 2 below
# it, after the schema is already built.

# ── Surface ────────────────────────────────────────────────────────────────
# Loopback by default. This is an operator console with a login form; publish
# it on 0.0.0.0 only when you mean to.
VEYRS_HTTP_BIND=127.0.0.1:8080

# development keeps /docs and /redoc open, which is the point of an evaluation
# stack. "production" closes them and makes config.assert_production_safe()
# meaningful — but this stack serves plain HTTP, so set VEYRS_PUBLIC_BASE_URL
# to the https address of whatever terminates TLS in front of it.
VEYRS_ENVIRONMENT=development
VEYRS_PUBLIC_BASE_URL=http://localhost:8080
VEYRS_CORS_ORIGINS=http://localhost:8080

# uvicorn processes. VEYRS handlers are synchronous SQLAlchemy, so throughput
# comes from processes, not from a bigger event loop. Raise together with the
# Postgres pool, not alone.
VEYRS_WORKERS=4

TZ=UTC

# ── Network ────────────────────────────────────────────────────────────────
# The console's address is pinned because uvicorn is told to trust
# X-Forwarded-For from exactly that address. Change both or neither.
VEYRS_SUBNET=172.29.0.0/16
VEYRS_CONSOLE_IP=172.29.0.10
# The API is deliberately NOT pinned: `docker compose run` makes a second
# container of that service and could not reuse a fixed address. nginx is told
# to re-resolve instead — see docker/console.conf.

# ── Background workers — profile `workers` ────────────────────────────────
#   docker/veyrs-docker.sh up --with-workers
#
# Off by default because a first `up` would otherwise start pulling the NVD
# corpus (hours, against a feed that rate-limits per source address) on a stack
# somebody is merely trying out. Turn them on for anything you intend to keep:
# WITHOUT THEM THE VULNERABILITY DATA DOES NOT AGE FORWARD and the SLA clocks
# do not advance, neither of which is visible anywhere in the console.
#
# Mail. Empty is not an error: `veyrs digest` still writes its notification
# rows, so nothing is lost -- nobody is told. Only smtp_from has a default in
# config.py; the rest are empty there too.
VEYRS_SMTP_HOST=
VEYRS_SMTP_PORT=25
VEYRS_SMTP_USER=
VEYRS_SMTP_PASSWORD=
VEYRS_SMTP_FROM=
VEYRS_SMTP_STARTTLS=true

# ── Scanner agent — profile `agent` ───────────────────────────────────────
#   docker/veyrs-docker.sh up --with-agent        (read docker/README.md first)
#
# This is the one component that sends unsolicited traffic to other people's
# machines. Both values below are REQUIRED for it and there is no default that
# would be safe:
#
#   TOKEN  mint it in the console, Settings -> Agents. It is a credential on
#          the agent data plane -- docker/.env is 0600 for this reason.
#   ALLOW  comma-separated hosts, wildcards or CIDRs. EMPTY MEANS NOTHING IS
#          SCANNABLE, not everything: deny-by-default is deliberate, so that
#          the operator of this machine decides what it may be pointed at
#          rather than trusting whatever the server hands it. The agent
#          refuses to start without it.
#
#   VEYRS_AGENT_ALLOW=example.com,*.internal.example,10.10.0.0/24
VEYRS_AGENT_TOKEN=
VEYRS_AGENT_ALLOW=
